---
import { Image } from 'astro:assets';
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import avatar from '../assets/avatar.jpg';
import bg from '../assets/bg.jpg';
import {
  ui,
  langs,
  langPath,
  profile,
  videos,
  featuredRelease,
  spotifyAlbums,
  discography,
  works,
  essays,
  timeline,
  links,
  type Lang,
} from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;

const nav = [
  { href: '#music', label: 'Music' },
  { href: '#works', label: 'Works' },
  { href: '#essays', label: 'Essays' },
  { href: '#about', label: 'About' },
  { href: '#links', label: 'Links' },
];
const year = new Date().getFullYear();
// このページ（日本語なら /、英語なら /en/）の QR をビルド時に SVG で作って埋め込む。
const pageUrl = new URL(`${base}${langPath[lang]}`, Astro.site).href;
const qrSvg = await QRCode.toString(pageUrl, {
  type: 'svg',
  margin: 1,
  color: { dark: '#16131a', light: '#ffffff' },
});
const qrIcon = `<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M3 3h8v8H3zm2 2v4h4V5zm8-2h8v8h-8zm2 2v4h4V5zM3 13h8v8H3zm2 2v4h4v-4zm11-2h2v2h-2zm-3 0h2v4h-2zm6 0h2v2h-2zm-3 3h2v2h-2zm3 0h2v5h-2zm-6 3h2v2h-2zm3 2h2v1h-2z"/></svg>`;
---

<Base lang={lang}>
  <div class="top-tools">
  <nav class="lang-switch" aria-label={ui.langNav[lang]}>
      {
        langs.map((l) =>
          l === lang ? (
            <span aria-current="page">{l.toUpperCase()}</span>
          ) : (
            <a href={`${base}${langPath[l]}`} hreflang={l} lang={l}>
              {l.toUpperCase()}
            </a>
          ),
        )
      }
    </nav>
    <button type="button" class="qr-open icon" aria-label={ui.showQr[lang]} set:html={qrIcon} />
  </div>

  <header class="hero">
    <Image src={bg} alt="" class="hero-bg" widths={[960, 1920]} sizes="100vw" loading="eager" />
    <div class="hero-inner">
      <Image src={avatar} alt={ui.avatarAlt[lang]} class="avatar" width={160} height={160} loading="eager" />
      <p class="catch">{profile.catchphrase}</p>
      <h1>
        {profile.name[lang]}<span class="en">{profile.subName[lang]}</span>
      </h1>
      <p class="roles">{profile.roles[lang]}</p>
      <p class="lead">{profile.lead[lang]}</p>
      <nav aria-label={ui.pageNav[lang]}>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <section id="music">
      <div class="head">
        <h2>Music</h2>
        <p>{ui.music[lang]}</p>
      </div>

      <div class="featured">
        <a class="cover" href={featuredRelease.url} target="_blank" rel="noopener">
          <Image src={featuredRelease.image} alt={featuredRelease.title} width={480} />
        </a>
        <div class="info">
          <p class="label">{ui.latestRelease[lang]}</p>
          <h3 class="title">{featuredRelease.title}</h3>
          <p class="meta">
            <time datetime={featuredRelease.date}>{featuredRelease.meta}</time>
          </p>
          <p class="desc">{featuredRelease.description[lang]}</p>
          <div class="switch" role="tablist" aria-label={ui.listenOrBuy[lang]}>
            <span class="knob" aria-hidden="true"></span>
            <button type="button" role="tab" aria-selected="true" data-slide="0">
              <span class="verb">{ui.listen[lang]}</span> Spotify
            </button>
            <button type="button" role="tab" aria-selected="false" data-slide="1">
              <span class="verb">{ui.buy[lang]}</span> Bandcamp
            </button>
          </div>
          <div class="slides">
            <div class="slide">
              <iframe
                title={`Spotify: ${featuredRelease.title}`}
                src={`https://open.spotify.com/embed/album/${featuredRelease.spotifyId}?theme=0`}
                height="152"
                loading="lazy"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              />
            </div>
            <div class="slide">
              <iframe
                class="bc"
                title={`Bandcamp: ${featuredRelease.title}`}
                src={`https://bandcamp.com/EmbeddedPlayer/album=${featuredRelease.bandcampId}/size=large/bgcol=333333/linkcol=e8a95e/tracklist=false/artwork=none/transparent=true/`}
                height="120"
                loading="lazy"
                seamless
              />
              <div class="buy">
                <a class="btn" href={featuredRelease.url} target="_blank" rel="noopener">{ui.buyOnBandcamp[lang]}</a>
                <span class="note">{featuredRelease.buyNote[lang]}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <ul class="videos">
        {
          videos.map((v) => (
            <li>
              <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener">
                <div class="thumb">
                  <img
                    src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
                    alt=""
                    width="480"
                    height="360"
                    loading="lazy"
                  />
                  <span class="play" aria-hidden="true" />
                </div>
                <h3>{v.title}</h3>
                <p>{v.note[lang]}</p>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="spotify">
        {
          spotifyAlbums.map((a) => (
            <iframe
              title={`Spotify: ${a.title}`}
              src={`https://open.spotify.com/embed/album/${a.id}?theme=0`}
              height="152"
              loading="lazy"
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            />
          ))
        }
      </div>

      <h3 class="sub">Discography</h3>
      <ul class="disco">
        {
          discography.map((r) => (
            <li>
              <time class="year" datetime={r.date}>
                {r.date.slice(0, 7).replace('-', '.')}
              </time>
              <span class="kind">{r.kind}</span>
              <span class="title">
                {r.url ? (
                  <a href={r.url} target="_blank" rel="noopener">
                    {r.title}
                  </a>
                ) : (
                  r.title
                )}
                {r.artist && <small> / {r.artist}</small>}
                {r.with && <small> with {r.with[lang]}</small>}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="works">
      <div class="head">
        <h2>Works</h2>
        <p>{ui.works[lang]}</p>
      </div>
      <ul class="cards">
        {
          works.map((w) => (
            <li>
              <a href={w.url} target="_blank" rel="noopener">
                <div class="card-img">
                  <Image src={w.image} alt="" width={640} />
                </div>
                <div class="card-body">
                  <span class="tag">{w.tag}</span>
                  <h3>{w.title[lang]}</h3>
                  <p>{w.description[lang]}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="essays">
      <div class="head">
        <h2>Essays</h2>
        <p>{ui.essays[lang]}</p>
      </div>
      <ul class="essays">
        {
          essays.map((e) => (
            <li>
              <a href={e.url} target="_blank" rel="noopener">
                <h3>{e.title[lang]}</h3>
                <p>{e.note[lang]}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="about">
      <div class="head">
        <h2>About</h2>
        <p>{ui.about[lang]}</p>
      </div>
      <div class="about">
        <div class="bio">
          {profile.about[lang].map((p) => <p>{p}</p>)}
        </div>
        <ol class="timeline">
          {
            timeline.map((t) => (
              <li>
                <span class="year">{t.year}</span>
                <p>{t.text[lang]}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="links">
      <div class="head">
        <h2>Links</h2>
        <p>{ui.links[lang]}</p>
      </div>
      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener">
                <span class="label">{l.label}</span>
                <span class="note">{l.note[lang]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer>
    <p>© {year} {profile.name[lang]} ({profile.subName[lang]})</p>
  </footer>

  <dialog class="qr-dialog" aria-label={ui.qrDialog[lang]}>
    <p class="qr-title">{profile.name[lang]} <span>{profile.subName[lang]}</span></p>
    <div class="qr-code" set:html={qrSvg} />
    <p class="qr-url">{pageUrl.replace(/^https:\/\//, '')}</p>
    <form method="dialog">
      <button type="submit" class="qr-close">{ui.close[lang]}</button>
    </form>
  </dialog>
  <script>
    // 「聴く / 買う」のスイッチと、横にスライドするプレイヤー。スワイプでも切り替わる。
    document.querySelectorAll<HTMLElement>('.featured').forEach((root) => {
      const track = root.querySelector<HTMLElement>('.slides');
      const sw = root.querySelector<HTMLElement>('.switch');
      if (!track || !sw) return;
      const buttons = [...sw.querySelectorAll<HTMLButtonElement>('[data-slide]')];
      const select = (i: number) => {
        buttons.forEach((b, j) => b.setAttribute('aria-selected', String(i === j)));
        sw.style.setProperty('--i', String(i));
      };
      buttons.forEach((b, i) =>
        b.addEventListener('click', () => {
          select(i);
          track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
        }),
      );
      let t = 0;
      track.addEventListener('scroll', () => {
        clearTimeout(t);
        t = window.setTimeout(() => select(Math.round(track.scrollLeft / track.clientWidth)), 60);
      });
    });
  </script>
  <script>
    // 右上の QR ボタンでダイアログを開く。外側を押しても閉じる。
    const dialog = document.querySelector<HTMLDialogElement>('.qr-dialog');
    document.querySelectorAll('.qr-open').forEach((b) => b.addEventListener('click', () => dialog?.showModal()));
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  </script>
</Base>

<style>
  /* ---------- Language switch ---------- */
  .top-tools {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 10;
    display: flex;
    gap: 8px;
  }
  .qr-open.icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 30px;
    padding: 0;
    color: var(--text);
    border: 1px solid rgba(236, 230, 238, 0.3);
    border-radius: 999px;
    background: rgba(22, 19, 26, 0.55);
    cursor: pointer;
  }
  .qr-open.icon:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .qr-dialog {
    padding: 28px 28px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--text);
    text-align: center;
    max-width: min(340px, calc(100vw - 32px));
  }
  .qr-dialog::backdrop {
    background: rgba(10, 8, 12, 0.7);
    backdrop-filter: blur(4px);
  }
  .qr-title {
    margin: 0 0 16px;
    font-family: var(--serif);
    font-size: 1.4rem;
  }
  .qr-title span {
    margin-left: 6px;
    font-family: var(--sans);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--muted);
  }
  .qr-code :global(svg) {
    display: block;
    width: 240px;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 10px;
  }
  .qr-url {
    margin: 12px 0 16px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .qr-close {
    padding: 6px 24px;
    font: inherit;
    font-size: 0.85rem;
    color: var(--bg);
    background: var(--accent);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
  }
  .lang-switch {
    display: flex;
    border: 1px solid rgba(236, 230, 238, 0.3);
    border-radius: 999px;
    overflow: hidden;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    background: rgba(22, 19, 26, 0.55);
  }
  .lang-switch a,
  .lang-switch span {
    padding: 4px 12px;
    text-decoration: none;
  }
  .lang-switch span {
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
  }
  .lang-switch a:hover {
    background: var(--accent-soft);
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 92vh;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 64px 16px;
    text-align: center;
  }
  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(22, 19, 26, 0.55) 0%, rgba(22, 19, 26, 0.7) 60%, var(--bg) 100%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }
  .hero :global(.avatar) {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 24px;
    border: 2px solid rgba(236, 230, 238, 0.25);
  }
  .catch {
    margin: 0;
    color: var(--accent);
    letter-spacing: 0.2em;
    font-size: 0.8rem;
    text-transform: uppercase;
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(2.6rem, 8vw, 4rem);
    line-height: 1.2;
    margin: 8px 0 4px;
  }
  h1 .en {
    display: block;
    font-size: 0.35em;
    letter-spacing: 0.3em;
    color: var(--muted);
    font-family: var(--sans);
    margin-top: 8px;
  }
  .roles {
    margin: 16px 0 0;
    font-weight: 500;
  }
  .lead {
    color: var(--muted);
    margin: 8px 0 0;
  }
  .hero nav ul {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .hero nav a {
    display: inline-block;
    padding: 6px 16px;
    border: 1px solid rgba(236, 230, 238, 0.3);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
    transition: background 0.2s, border-color 0.2s;
  }
  .hero nav a:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  /* ---------- Sections ---------- */
  main {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 16px;
  }
  section {
    padding: 72px 0;
    border-top: 1px solid var(--line);
  }
  section:first-child {
    border-top: none;
  }
  .head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 32px;
  }
  .head h2 {
    font-family: var(--serif);
    font-size: 2rem;
    margin: 0;
  }
  .head p {
    margin: 0;
    color: var(--muted);
  }
  ul,
  ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }
  .sub {
    font-family: var(--serif);
    font-size: 1.3rem;
    margin: 48px 0 16px;
  }

  /* ---------- Music ---------- */
  .videos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 24px;
  }
  .videos a {
    text-decoration: none;
    display: block;
  }
  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-raised);
    margin-bottom: 12px;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .videos a:hover .thumb img {
    transform: scale(1.04);
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(22, 19, 26, 0.7);
  }
  .play::after {
    content: '';
    position: absolute;
    left: 19px;
    top: 15px;
    border-style: solid;
    border-width: 9px 0 9px 14px;
    border-color: transparent transparent transparent var(--text);
  }
  .videos p {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .featured {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 32px;
    align-items: center;
    padding: 24px;
    margin-bottom: 48px;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .featured .cover :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 10px;
  }
  .featured .label {
    margin: 0;
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .featured .title {
    font-family: var(--serif);
    font-size: 2.2rem;
    line-height: 1.2;
    margin: 4px 0 0;
  }
  .featured .meta {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .featured .desc {
    margin: 12px 0 16px;
  }
  /* Bandcamp のプレイヤーは 700px より広がらないので、枠もそこで止める */
  .featured iframe {
    width: 100%;
    max-width: 700px;
    border: 0;
    border-radius: 12px;
    background: #333333;
  }
  .switch {
    --i: 0;
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    margin-bottom: 12px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
  }
  .switch .knob {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc(50% - 4px);
    border-radius: 999px;
    background: var(--accent);
    transform: translateX(calc(var(--i) * 100%));
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .switch button {
    position: relative;
    font: inherit;
    font-size: 0.85rem;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 6px 18px;
    cursor: pointer;
    transition: color 0.35s;
    white-space: nowrap;
  }
  .switch button[aria-selected='true'] {
    color: var(--bg);
    font-weight: 700;
  }
  .switch .verb {
    margin-right: 4px;
  }
  .slides {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    max-width: 700px;
  }
  .slides::-webkit-scrollbar {
    display: none;
  }
  .slide {
    min-width: 0;
    scroll-snap-align: start;
  }
  .slide iframe {
    width: 100%;
    border: 0;
    border-radius: 12px;
    display: block;
  }
  .slide iframe.bc {
    background: #333333;
  }
  .buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-top: 12px;
  }
  .buy .btn {
    display: inline-block;
    padding: 8px 20px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .buy .note {
    color: var(--muted);
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .switch .knob { transition: none; }
  }
  .spotify {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-top: 40px;
  }
  .spotify iframe {
    width: 100%;
    border: 0;
    border-radius: 12px;
  }
  .disco li {
    display: grid;
    grid-template-columns: 4.5em 4.5em 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .disco .year {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .disco .kind {
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.05em;
  }
  .disco small {
    color: var(--muted);
  }
  .disco a {
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  /* ---------- Works ---------- */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }
  .cards a {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }
  .cards a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card-img {
    aspect-ratio: 16 / 10;
    background: #fff;
    overflow: hidden;
  }
  .card-img :global(img) {
    width: 100%;
